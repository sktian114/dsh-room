# 统一编码与换行；JS/JSON/YAML 走 LF（.gitattributes 也会强制）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.png]
insert_final_newline = false
