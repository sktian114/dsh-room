{
  "name": "dsh-room",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 房间联机：在蒲公英等组网内输入 房主地址:端口 即可加入房间，共享房主工作区与会话",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "install.ps1"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "preview": "node test/render-preview.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "room",
    "lan",
    "remote"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
